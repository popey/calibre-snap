#!/bin/sh
export CALIBRE_CONFIG_DIRECTORY="$SNAP_USER_DATA/config"
export XDG_CACHE_HOME="$SNAP_USER_COMMON/.cache"
export CALIBRE_TEMP_DIR="$SNAP_USER_COMMON/.cache/tmp"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
export QTWEBENGINE_DISABLE_SANDBOX=1
# Chromium otherwise tries to allocate files outside the snap shared-memory namespace.
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:-} --disable-dev-shm-usage"
export QT_STYLE_OVERRIDE=Fusion
# Calibre's native launcher has a fixed-size LD_LIBRARY_PATH buffer.
# It prepends its own bundled lib directory; retain only required runtime roots.
export LD_LIBRARY_PATH="$SNAP/usr/lib/x86_64-linux-gnu:$SNAP/gpu-2404/usr/lib/x86_64-linux-gnu:$SNAP/gnome-platform/usr/lib/x86_64-linux-gnu"
export LD_PRELOAD="$SNAP/lib/libcalibre-snap-compat.so"
export PATH="$SNAP/opt/calibre:$PATH"
mkdir -p "$CALIBRE_CONFIG_DIRECTORY" "$XDG_CACHE_HOME" "$CALIBRE_TEMP_DIR"
exec "$@"
